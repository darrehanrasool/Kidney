# KidneyCare-AI Environment Variables Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME=KidneyCare-AI

# Hardware Acceleration Configuration
ACCELERATOR=auto # Options: auto, mps, cuda, cpu
MAX_GPU_MEMORY_FRACTION=0.80
NUM_WORKERS=0 # 0 recommended for low-memory / macOS multiprocessing

# Data Directories
DATA_RAW_DIR=data/raw/clinical
DATA_PROCESSED_DIR=data/processed
CHECKPOINT_DIR=checkpoints
OUTPUT_DIR=outputs

# Dataset API Credentials (Optional for automated repositories / mirrors)
KAGGLE_USERNAME=
KAGGLE_KEY=
UCI_DATASET_URL=https://archive.ics.uci.edu/static/public/336/chronic_kidney_disease.zip
ARXIV_RATE_LIMIT=3.0

# Reproducibility Seed
RANDOM_SEED=42
