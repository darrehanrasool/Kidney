# Large Data & Binary Artifacts (keep structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
!data/raw/**/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
!data/splits/**/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/external/*
!data/external/.gitkeep

# Checkpoints & Model Weights (store metadata, ignore heavy weights)
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.bin
checkpoints/**/*.onnx
!checkpoints/**/.gitkeep
outputs/trained_models/*
!outputs/trained_models/.gitkeep
outputs/predictions/*
!outputs/predictions/.gitkeep

# Log files
logs/**/*.log
logs/**/*.jsonl
!logs/**/.gitkeep

# Research manuscripts, large PDFs & preprints (kept local)
papers/pdf/*.pdf
!papers/pdf/.gitkeep
